---
// Favorites page — reads airport favorites stored in localStorage
import Layout from '../layouts/Layout.astro';
import { FAVORITES_PAGE as T } from '../constants/pages';
---

<Layout title={T.meta.title} description={T.meta.description}>
  <section class="mx-auto max-w-6xl px-5 pb-16 pt-8 sm:pt-12">
    <!-- Header -->
    <div class="border-b border-line pb-6">
      <div class="flex items-center gap-2 text-[13px] text-muted mb-2">
        <a href="/" class="hover:text-ink">首页</a>
        <span>/</span>
        <span class="text-ink font-medium">我的收藏</span>
      </div>
      <h1 class="font-display text-[clamp(28px,4vw,40px)] font-extrabold tracking-tight text-ink">{T.title}</h1>
      <p data-fav-sub class="mt-2 text-[15px] text-muted">{T.subEmpty}</p>
    </div>

    <!-- Active Airport Grid -->
    <div data-fav-grid class="mt-8 hidden grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>

    <!-- Empty State -->
    <div data-fav-empty class="hidden py-16 text-center sm:py-24">
      <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-tile text-3xl">
        {T.empty.icon}
      </div>
      <h2 class="text-[18px] font-bold text-ink">{T.empty.title}</h2>
      <p class="mt-1.5 text-[14px] text-muted max-w-md mx-auto">{T.empty.text}</p>
      <a
        href={T.empty.cta.href}
        class="mt-6 inline-flex items-center gap-2 rounded-lg bg-pine px-6 py-3 text-[14px] font-semibold text-white shadow-sm hover:bg-pine-deep transition"
      >
        <span>{T.empty.cta.label}</span>
        <span>→</span>
      </a>
    </div>
  </section>

  <script>
    import { favorites, toggleFavorite } from '../lib/favorites';
    import { FAVORITES_PAGE as T } from '../constants/pages';

    interface AirportIndexItem {
      handle: string;
      title: string;
      rank: number;
      price: number;
      priceDisplay: string;
      lineType: string;
      coupon: string;
      tags: string;
      image: string;
      affLink: string;
    }

    const index: AirportIndexItem[] = JSON.parse(document.body.dataset.searchIndex || '[]');
    const grid = document.querySelector<HTMLElement>('[data-fav-grid]')!;
    const empty = document.querySelector<HTMLElement>('[data-fav-empty]')!;
    const sub = document.querySelector<HTMLElement>('[data-fav-sub]')!;

    function render() {
      const list = favorites.get();
      const items = index.filter((p) => list.includes(p.handle));

      grid.classList.toggle('hidden', items.length === 0);
      grid.classList.toggle('grid', items.length > 0);
      empty.classList.toggle('hidden', items.length > 0);
      sub.textContent = items.length ? T.subCount(items.length) : T.subEmpty;

      grid.innerHTML = items
        .map(
          (p) => `
          <div class="group relative flex flex-col justify-between rounded-xl border border-line bg-paper p-5 transition-all hover:border-pine/50 hover:shadow-lg">
            <!-- Top Row -->
            <div>
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-pine/10 px-2.5 py-0.5 text-[12px] font-bold text-pine font-mono">
                  #${p.rank} 推荐
                </span>
                <button
                  type="button"
                  data-remove-fav="${p.handle}"
                  class="rounded-md p-1.5 text-red-500 hover:bg-tile transition"
                  title="移除收藏"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.8">
                    <path d="M12 20.5c-5.5-3.6-8.5-6.9-8.5-10.4A4.6 4.6 0 0 1 8.1 5.4c1.6 0 3 .8 3.9 2.1a4.7 4.7 0 0 1 3.9-2.1 4.6 4.6 0 0 1 4.6 4.7c0 3.5-3 6.8-8.5 10.4z"/>
                  </svg>
                </button>
              </div>

              <a href="/airports/${p.handle}" class="block group-hover:text-pine transition">
                <h3 class="font-display text-[18px] font-bold text-ink group-hover:text-pine transition">${p.title}</h3>
                <p class="mt-1 text-[13px] text-muted line-clamp-2">${p.tags}</p>
              </a>

              <div class="mt-4 flex items-baseline gap-2">
                <span class="text-[20px] font-bold text-pine font-mono">${p.priceDisplay}</span>
                <span class="rounded bg-tile px-2 py-0.5 text-[11px] font-medium text-muted">${p.lineType}</span>
              </div>
            </div>

            <!-- Bottom Actions -->
            <div class="mt-5 pt-4 border-t border-line/60 flex items-center gap-2">
              <a
                href="/airports/${p.handle}"
                class="flex-1 rounded-md border border-line bg-tile/40 px-3 py-2 text-center text-[13px] font-semibold text-ink hover:bg-tile transition"
              >
                评测详情
              </a>
              <a
                href="${p.affLink}"
                target="_blank"
                rel="nofollow sponsored noopener"
                class="flex-1 rounded-md bg-pine px-3 py-2 text-center text-[13px] font-semibold text-white hover:bg-pine-deep transition"
              >
                前往官网
              </a>
            </div>
          </div>`,
        )
        .join('');

      // Bind remove buttons
      grid.querySelectorAll<HTMLButtonElement>('[data-remove-fav]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const handle = btn.getAttribute('data-remove-fav');
          if (handle) {
            toggleFavorite(handle);
            render();
          }
        });
      });
    }

    render();
    window.addEventListener('storage', render);
  </script>
</Layout>
