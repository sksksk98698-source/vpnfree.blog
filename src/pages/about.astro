---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../constants/components';
import { ABOUT as T } from '../constants/pages';
---

<Layout title={T.meta.title} description={T.meta.description}>
  <!-- About Hero -->
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-6 pt-6 sm:pb-12 md:grid-cols-[1.1fr_1fr] md:pt-14">
    <div>
      <div class="mb-6 flex items-center gap-3">
        <img src={SITE.logoDark} alt={SITE.name} class="logo-on-light h-14 w-14 rounded-xl" width="56" height="56" />
        <img src={SITE.logoLight} alt={SITE.name} class="logo-on-dark h-14 w-14 rounded-xl" width="56" height="56" />
        <span class="font-display text-2xl font-bold tracking-tight">{SITE.name}</span>
      </div>
      <h1 class="font-display text-[clamp(36px,5vw,60px)] font-extrabold leading-[1.02] tracking-tight">
        {T.hero.title}
      </h1>
      {T.hero.paragraphs.map((p, i) => (
        <p class:list={['max-w-[52ch] text-[16px] leading-relaxed text-muted', i === 0 ? 'mt-5' : 'mt-4']}>{p}</p>
      ))}
    </div>
    <div class="overflow-hidden rounded-xl bg-tile border border-line shadow-sm">
      <img src={T.hero.image.src} alt={T.hero.image.alt} class="aspect-[4/5] w-full object-cover" width="600" height="750" />
    </div>
  </section>

  <!-- Key Metrics -->
  <section class="mx-auto max-w-6xl px-5 py-6 sm:py-10">
    <div class="grid gap-4 rounded-2xl border border-line bg-tile/60 p-6 text-center sm:grid-cols-4 sm:gap-8 sm:p-10">
      {T.numbers.map((n) => (
        <div>
          <p class="font-display text-3xl sm:text-4xl font-extrabold text-pine">{n.num}</p>
          <p class="mt-1.5 text-[14px] font-medium text-muted">{n.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Quality Standards Section -->
  <section class="mx-auto max-w-6xl px-5 py-6 sm:py-12">
    <div class="grid gap-8 rounded-2xl border border-line bg-tile/40 p-6 sm:gap-12 sm:p-12 md:grid-cols-2">
      <div>
        <p class="text-[13px] font-semibold uppercase tracking-wider text-pine">{T.standards.eyebrow}</p>
        <h2 class="mt-3 font-display text-[clamp(26px,3.2vw,36px)] font-bold leading-tight tracking-tight">
          {T.standards.title}
        </h2>
        {T.standards.paragraphs.map((p) => (
          <p class="mt-4 text-[15px] leading-relaxed text-muted">{p}</p>
        ))}
      </div>
      <div class="flex flex-col justify-center">
        <ul class="space-y-4 text-[15px] leading-relaxed text-muted">
          {T.standards.points.map((pt) => (
            <li class="flex items-start gap-3">
              <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-pine/10 text-pine">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span>{pt}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="mx-auto flex max-w-3xl flex-col items-center justify-center gap-4 px-5 py-10 sm:py-16 text-center">
    <h2 class="font-display text-3xl font-bold">{T.cta.title}</h2>
    <p class="text-[16px] text-muted max-w-[50ch]">{T.cta.text}</p>
    <a href={T.cta.button.href} class="mt-2 rounded-md bg-pine px-7 py-3.5 text-[15px] font-semibold text-white hover:bg-pine-deep transition">
      {T.cta.button.label}
    </a>
  </section>
</Layout>
