---
import '../styles/global.css';
import { SITE, ANNOUNCEMENT, HEADER, SEARCH, FOOTER, THANKS_MODAL, CART, NAV_DRAWER, SEARCH_VERIFICATION } from '../constants/components';
import { AIRPORTS } from '../data/airports';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogType?: 'website' | 'article' | 'product';
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical,
  image = '/images/og-default.jpg',
  ogType = 'website',
  robots = 'index, follow',
  publishedTime,
  modifiedTime,
  author = SITE.name,
  jsonLd,
} = Astro.props;

// Absolute Canonical & Social URLs for 100% SEO compliance
// 规范：统一使用正式生产主域名 https://vpnfree.blog
const siteOrigin = 'https://vpnfree.blog';
const rawPathname = Astro.url.pathname.replace(/\/$/, '');
const defaultCanonicalURL = rawPathname === '' ? `${siteOrigin}/` : `${siteOrigin}${rawPathname}`;
const canonicalURL = canonical || defaultCanonicalURL;
const ogImageURL = new URL(image, siteOrigin).href;

// Active navigation highlight
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const navCls = (href: string, base: string, active: string) =>
  `${base} ${isActive(href) ? active : ""}`.trim();

// Client-side search index for all 42 airports
const searchIndex = JSON.stringify(
  AIRPORTS.map((a) => ({
    handle: a.slug,
    title: a.name,
    rank: a.rank,
    price: a.minPriceMonthly,
    priceDisplay: a.priceDisplay,
    lineType: a.lineType,
    coupon: a.coupon,
    tags: a.tags.join(' ') + ' ' + a.lineType + ' ' + a.protocols.join(' ') + ' ' + a.coverageRegions.join(' '),
    image: a.speedTestImages[0]?.url || '/logo/brand-dark.svg',
    affLink: a.affLink,
  })),
);

// Standard Organization & WebSite JSON-LD Schemas
const baseWebsiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: siteOrigin,
  description: SITE.defaultDescription,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteOrigin}/airports?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  alternateName: SITE.enName,
  url: siteOrigin,
  logo: `${siteOrigin}${SITE.logoDark}`,
  description: SITE.defaultDescription,
  email: SITE.contactEmail,
};

const combinedJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? [baseWebsiteSchema, organizationSchema, ...jsonLd]
    : [baseWebsiteSchema, organizationSchema, jsonLd]
  : [baseWebsiteSchema, organizationSchema];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO Metadata -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robots} />

    <!-- Search Engine Webmaster Verification Tags (预留安全验证接口，源码直出) -->
    {SEARCH_VERIFICATION.google && <meta name="google-site-verification" content={SEARCH_VERIFICATION.google} />}
    {SEARCH_VERIFICATION.bing && <meta name="msvalidate.01" content={SEARCH_VERIFICATION.bing} />}
    {SEARCH_VERIFICATION.shenma && <meta name="shenma-site-verification" content={SEARCH_VERIFICATION.shenma} />}
    {SEARCH_VERIFICATION.baidu && <meta name="baidu-site-verification" content={SEARCH_VERIFICATION.baidu} />}

    <!-- Favicon & PWA App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1e4d3b" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(combinedJsonLd)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      if (localStorage.getItem('app-theme') === 'dark' || (!localStorage.getItem('app-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-paper font-sans text-ink antialiased" data-search-index={searchIndex}>
    <!-- Top Announcement Bar -->
    <p class="flex flex-wrap items-center justify-center gap-x-2 bg-pine px-4 py-2 text-center text-[13px] font-medium text-pine-soft">
      <span>{ANNOUNCEMENT.text}</span>
      <span class="opacity-50">·</span>
      <a
        href={ANNOUNCEMENT.linkHref}
        class="font-semibold text-white underline underline-offset-2 hover:opacity-90"
      >{ANNOUNCEMENT.linkLabel}</a>
    </p>

    <!-- Global Header -->
    <header class="sticky top-2 z-40 mx-auto w-full max-w-6xl px-3 sm:top-3 sm:px-5">
      <div class="overflow-hidden rounded-2xl border border-line bg-paper/90 shadow-sm backdrop-blur">
        <nav class="flex h-14 items-center justify-between px-3 sm:h-16 sm:px-5">
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-2.5">
              <img src={SITE.logoDark} alt={SITE.name} class="logo-on-light h-8 w-8 rounded-lg" width="32" height="32" />
              <img src={SITE.logoLight} alt={SITE.name} class="logo-on-dark h-8 w-8 rounded-lg" width="32" height="32" />
              <div class="flex flex-col">
                <span class="font-display text-[20px] font-bold tracking-tight leading-none text-ink">{SITE.name}</span>
                <span class="text-[10px] tracking-wider text-muted font-mono uppercase">vpnfree.blog</span>
              </div>
            </a>
            <button id="theme-button" data-theme-toggle class="hidden rounded-md p-2 text-muted hover:bg-tile hover:text-ink sm:block" aria-label={HEADER.aria.theme}>
              <svg data-icon-moon width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
              </svg>
              <svg data-icon-sun class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <circle cx="12" cy="12" r="4.5" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" />
              </svg>
            </button>
          </div>

          <div class="hidden items-center gap-1 text-[14px] text-muted md:flex">
            {HEADER.navLinks.map((l) => (
              <a href={l.href} class={navCls(l.href, "rounded-md px-3 py-2 hover:bg-tile hover:text-ink transition", "bg-tile text-ink font-semibold")}>{l.label}</a>
            ))}
          </div>

          <div class="flex items-center gap-1.5">
            <button id="search-button" class="flex items-center gap-2 rounded-md border border-line px-3 py-1.5 text-muted hover:border-ink hover:text-ink text-[13px]" aria-label={HEADER.aria.search} aria-expanded="false">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
              </svg>
              <span class="hidden sm:inline">搜索机场…</span>
              <kbd class="hidden rounded bg-tile px-1.5 py-0.5 text-[10px] text-muted sm:inline-block">Ctrl K</kbd>
            </button>
            <a href="/favorites" class="relative rounded-md p-2 text-muted hover:bg-tile hover:text-ink" aria-label={HEADER.aria.favorites} title="收藏的机场">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20.5c-5.5-3.6-8.5-6.9-8.5-10.4A4.6 4.6 0 0 1 8.1 5.4c1.6 0 3 .8 3.9 2.1a4.7 4.7 0 0 1 3.9-2.1 4.6 4.6 0 0 1 4.6 4.7c0 3.5-3 6.8-8.5 10.4z" />
              </svg>
              <span id="fav-count" class="absolute -right-0.5 -top-0.5 hidden rounded-full bg-pine px-1.5 py-0.5 text-[10px] font-semibold leading-none text-white"></span>
            </a>
            <button id="nav-button" class="rounded-md p-2 text-muted hover:bg-tile hover:text-ink md:hidden" aria-label={HEADER.aria.menu} aria-expanded="false">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <path d="M3 5.5h14M3 10h14M3 14.5h14" />
              </svg>
            </button>
          </div>
        </nav>

        <!-- Live Instant Search Panel -->
        <div id="search-panel" class="hidden border-t border-line bg-paper">
          <div class="mx-auto max-w-6xl px-5 py-4">
            <div class="flex items-center gap-3 rounded-md border border-line px-4 focus-within:border-pine bg-paper">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 text-muted">
                <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
              </svg>
              <input
                id="search-input"
                type="search"
                placeholder={SEARCH.placeholder}
                class="w-full bg-transparent py-3 text-[15px] outline-none placeholder:text-muted"
                autocomplete="off"
              />
              <kbd class="hidden rounded border border-line px-1.5 py-0.5 text-[11px] text-muted sm:block">{SEARCH.escHint}</kbd>
            </div>
            <div id="search-results" class="hidden gap-3 py-4 max-h-[60vh] overflow-y-auto sm:grid-cols-2 md:grid-cols-3"></div>
            <p id="search-empty" class="hidden py-6 text-center text-[14px] text-muted">{SEARCH.emptyText}</p>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="mx-auto w-full max-w-6xl px-3 pb-8 pt-10 sm:px-5">
      <div class="rounded-2xl border border-line bg-tile/60">
        <div class="grid gap-8 px-5 py-8 sm:grid-cols-[1.3fr_1.7fr] sm:gap-12 sm:px-10 sm:py-12">
          <div>
            <p class="flex items-center gap-2.5 font-display text-xl font-bold">
              <img src={SITE.logoDark} alt={SITE.name} class="logo-on-light h-7 w-7 rounded-md" width="28" height="28" />
              <img src={SITE.logoLight} alt={SITE.name} class="logo-on-dark h-7 w-7 rounded-md" width="28" height="28" />
              <span>{SITE.name}</span>
            </p>
            <p class="mt-3.5 max-w-[42ch] text-[14px] leading-relaxed text-muted">{FOOTER.tagline}</p>
            <div class="mt-4 flex flex-wrap gap-2 text-[12px] text-muted font-mono">
              <span class="rounded bg-paper px-2 py-1 border border-line">IEPL 专线</span>
              <span class="rounded bg-paper px-2 py-1 border border-line">IPLC 内网直连</span>
              <span class="rounded bg-paper px-2 py-1 border border-line">VLESS / Shadowsocks</span>
              <span class="rounded bg-paper px-2 py-1 border border-line">MAI-TEST-BOT 实测</span>
            </div>
          </div>
          <nav class="grid grid-cols-2 gap-8 text-[14px] sm:grid-cols-3" aria-label="Footer Navigation">
            {FOOTER.columns.map((col) => (
              <div>
                <p class="font-semibold text-ink">{col.title}</p>
                <ul class="mt-3.5 space-y-2 text-muted">
                  {col.links.map((l) => (
                    <li>
                      <a
                        href={l.href}
                        class={navCls(l.href, "hover:text-ink hover:underline underline-offset-4 transition", "text-ink font-semibold underline")}
                      >{l.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </div>

        <!-- Compliance & Affiliate Disclosure -->
        <div class="border-t border-line px-5 py-4 sm:px-10 bg-tile/40 text-[12px] text-muted leading-relaxed">
          <p>{FOOTER.affDisclaimer}</p>
        </div>

        <!-- Copyright & Legal -->
        <div class="flex flex-col items-center justify-between gap-y-3 border-t border-line px-5 py-4 text-[13px] text-muted sm:flex-row sm:px-10">
          <p>{FOOTER.copyright}</p>
          <div class="flex items-center gap-5">
            {FOOTER.legalLinks.map((l) => (
              <a href={l.href} class="hover:text-ink hover:underline underline-offset-4">{l.label}</a>
            ))}
          </div>
        </div>
      </div>
    </footer>

    <!-- Coupon Copied Modal -->
    <div id="coupon-modal" class="fixed inset-0 z-[60] hidden items-center justify-center p-5">
      <div class="absolute inset-0 bg-ink/50" data-modal-close></div>
      <div class="relative w-full max-w-sm rounded-xl bg-paper p-8 text-center shadow-2xl border border-line">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-pine/10 text-pine font-display text-2xl font-bold">
          ✓
        </div>
        <h3 class="mt-4 font-display text-2xl font-bold">已复制官方优惠码！</h3>
        <p class="mt-2 text-[14px] leading-relaxed text-muted" id="coupon-modal-text">
          优惠券代码已自动复制到剪贴板。前往官方购买结算时粘贴，即可享受专属折扣！
        </p>
        <div class="my-4 rounded-lg bg-tile p-3 font-mono text-xl font-bold text-pine tracking-wider" id="coupon-modal-code">
          AMM
        </div>
        <a
          id="coupon-modal-link"
          href="/airports"
          target="_blank"
          rel="nofollow sponsored noopener"
          class="mt-2 block w-full rounded-md bg-pine py-3.5 text-[15px] font-semibold text-white hover:bg-pine-deep transition"
        >直达官方注册开通 &rarr;</a>
        <button data-modal-close class="mt-3 w-full rounded-md py-2 text-[14px] text-muted hover:text-ink">
          关闭
        </button>
      </div>
    </div>

    <!-- Mobile Nav Drawer -->
    <div id="nav-backdrop" class="fixed inset-0 z-40 bg-ink/40" aria-hidden="true"></div>
    <aside id="nav-drawer" class="fixed bottom-4 right-4 top-4 z-50 flex w-[calc(100%-2rem)] max-w-sm flex-col overflow-hidden rounded-2xl border border-line bg-paper shadow-2xl" aria-label={NAV_DRAWER.ariaDrawer}>
      <div class="flex items-center justify-between border-b border-line px-4 py-4">
        <h2 class="flex items-center gap-2 font-display text-xl font-bold">
          <img src={SITE.logoDark} alt={SITE.name} class="logo-on-light h-7 w-7 rounded-md" width="28" height="28" />
          <img src={SITE.logoLight} alt={SITE.name} class="logo-on-dark h-7 w-7 rounded-md" width="28" height="28" />
          {SITE.name}
        </h2>
        <div class="flex items-center gap-0.5">
          <a href="/favorites" class="rounded-md p-2 text-muted hover:bg-tile hover:text-ink" aria-label={HEADER.aria.favorites}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20.5c-5.5-3.6-8.5-6.9-8.5-10.4A4.6 4.6 0 0 1 8.1 5.4c1.6 0 3 .8 3.9 2.1a4.7 4.7 0 0 1 3.9-2.1 4.6 4.6 0 0 1 4.6 4.7c0 3.5-3 6.8-8.5 10.4z" />
            </svg>
          </a>
          <button data-theme-toggle class="rounded-md p-2 text-muted hover:bg-tile hover:text-ink" aria-label={HEADER.aria.theme}>
            <svg data-icon-moon width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
            <svg data-icon-sun class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <circle cx="12" cy="12" r="4.5" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" />
            </svg>
          </button>
          <button id="nav-close" class="rounded-md p-2 text-muted hover:text-ink" aria-label={NAV_DRAWER.ariaClose}>✕</button>
        </div>
      </div>
      <nav class="flex-1 overflow-y-auto px-4 py-4 text-[16px] font-medium">
        <a href={NAV_DRAWER.home.href} class={navCls(NAV_DRAWER.home.href, "block rounded-md px-3 py-3 hover:bg-tile", "bg-tile font-semibold")}>{NAV_DRAWER.home.label}</a>
        <div class="mb-1 ml-3 border-l border-line pl-3 my-2 space-y-1">
          <p class="px-3 pt-2 text-[12px] font-semibold text-muted uppercase tracking-wider">GEO & 专题推荐</p>
          {NAV_DRAWER.collections.map((l) => (
            <a href={l.href} class={navCls(l.href, "block rounded-md px-3 py-2 text-[14px] text-muted hover:bg-tile hover:text-ink", "bg-tile !text-ink font-semibold")}>{l.label}</a>
          ))}
        </div>
        {NAV_DRAWER.pages.map((l) => (
          <a href={l.href} class={navCls(l.href, "block rounded-md px-3 py-2.5 hover:bg-tile", "bg-tile font-semibold")}>{l.label}</a>
        ))}
      </nav>
      <div class="border-t border-line px-6 py-4 text-[13px] text-muted space-y-1 bg-tile/40">
        <p>{NAV_DRAWER.footer.supportText}</p>
        <p class="text-[12px] opacity-75">{NAV_DRAWER.footer.hoursText}</p>
      </div>
    </aside>

    <!-- Client Scripts for Search, Theme & Modals -->
    <script>
      import { favorites, toggleFavorite } from '../lib/favorites';

      const $ = (id: string) => document.getElementById(id)!;

      // Theme toggle: header button & drawer button
      const themeToggles = document.querySelectorAll<HTMLElement>('[data-theme-toggle]');
      function syncThemeIcon() {
        const dark = document.documentElement.classList.contains('dark');
        themeToggles.forEach((btn) => {
          btn.querySelector('[data-icon-moon]')?.classList.toggle('hidden', dark);
          btn.querySelector('[data-icon-sun]')?.classList.toggle('hidden', !dark);
        });
      }
      themeToggles.forEach((btn) =>
        btn.addEventListener('click', () => {
          const dark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('app-theme', dark ? 'dark' : 'light');
          syncThemeIcon();
        })
      );
      syncThemeIcon();

      // Search functionality
      const searchPanel = $('search-panel');
      const searchInput = $('search-input') as HTMLInputElement;
      const searchResults = $('search-results');
      const searchEmpty = $('search-empty');
      const index: {
        handle: string;
        title: string;
        rank: number;
        price: number;
        priceDisplay: string;
        lineType: string;
        coupon: string;
        tags: string;
        image: string;
        affLink: string;
      }[] = JSON.parse(document.body.dataset.searchIndex || '[]');

      function renderSearch(q: string) {
        const hits = q
          ? index.filter((p) => (p.title + ' ' + p.tags + ' ' + p.lineType).toLowerCase().includes(q)).slice(0, 9)
          : index.slice(0, 6);

        searchEmpty.classList.toggle('hidden', hits.length > 0);
        searchResults.classList.toggle('hidden', hits.length === 0);
        searchResults.classList.toggle('grid', hits.length > 0);
        searchResults.innerHTML = hits
          .map(
            (p) => `
            <div class="rounded-xl border border-line bg-tile/50 p-3.5 hover:border-pine transition flex items-center justify-between gap-3">
              <a href="/airports/${p.handle}" class="flex items-center gap-3 min-w-0">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-pine/10 text-[12px] font-bold text-pine font-mono">#${p.rank}</span>
                <div class="min-w-0">
                  <span class="block truncate text-[15px] font-semibold text-ink">${p.title}</span>
                  <span class="text-[12px] text-muted">${p.lineType} · <strong class="text-pine">${p.priceDisplay}</strong></span>
                </div>
              </a>
              <a href="${p.affLink}" target="_blank" rel="nofollow sponsored noopener" class="shrink-0 rounded-md bg-pine px-3 py-1.5 text-[12px] font-semibold text-white hover:bg-pine-deep transition">
                官网
              </a>
            </div>`,
          )
          .join('');
      }

      function toggleSearch(show?: boolean) {
        const willShow = show ?? searchPanel.classList.contains('hidden');
        searchPanel.classList.toggle('hidden', !willShow);
        $('search-button')?.setAttribute('aria-expanded', String(willShow));
        if (willShow) {
          renderSearch(searchInput.value.trim().toLowerCase());
          searchInput.focus();
        }
      }
      $('search-button')?.addEventListener('click', () => toggleSearch());
      searchInput?.addEventListener('input', () => renderSearch(searchInput.value.trim().toLowerCase()));

      function openNav() { document.body.classList.add('nav-open'); }
      function closeNav() { document.body.classList.remove('nav-open'); }
      $('nav-button')?.addEventListener('click', openNav);
      $('nav-close')?.addEventListener('click', closeNav);
      $('nav-backdrop')?.addEventListener('click', closeNav);

      function closeModal() {
        $('coupon-modal')?.classList.add('hidden');
        $('coupon-modal')?.classList.remove('flex');
      }
      document.querySelectorAll('[data-modal-close]').forEach((el) => el.addEventListener('click', closeModal));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeModal();
          closeNav();
          toggleSearch(false);
        }
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          toggleSearch(true);
        }
      });

      // Quick coupon copy and trigger modal
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy-coupon]');
        if (!btn) return;
        const coupon = btn.dataset.copyCoupon;
        const link = btn.dataset.affLink;
        if (coupon) {
          navigator.clipboard?.writeText(coupon);
          const modalCode = $('coupon-modal-code');
          const modalLink = $('coupon-modal-link') as HTMLAnchorElement;
          if (modalCode) modalCode.textContent = coupon;
          if (modalLink && link) modalLink.href = link;
          const modal = $('coupon-modal');
          if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
          }
        }
      });

      // Favorites
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-fav-toggle]');
        if (!btn) return;
        toggleFavorite(btn.dataset.favToggle!);
      });
      function renderFavs() {
        const list = favorites.get();
        document.querySelectorAll<HTMLElement>('[data-fav-toggle]').forEach((b) => {
          b.classList.toggle('is-fav', list.includes(b.dataset.favToggle!));
        });
        const badge = document.getElementById('fav-count');
        if (badge) {
          badge.textContent = String(list.length);
          badge.classList.toggle('hidden', list.length === 0);
        }
      }
      favorites.subscribe(renderFavs);
      renderFavs();
    </script>
  </body>
</html>
